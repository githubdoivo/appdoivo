# Porta do servidor
PORT=3000

# Deixa vazio (ou qualquer valor != "production") em dev/testes. So a
# producao real (fly.toml) define isto como "production" - desliga
# ADMIN_TOKEN abaixo (o atalho de login "mossy" tem o seu proprio
# interruptor agora, ver ENABLE_DEV_LOGIN mais abaixo).
NODE_ENV=

# Segredo usado para cifrar e indexar as chaves de acesso dos utilizadores.
# Mantem-no fora da base de dados e nunca o partilhes. Se o mudares, ninguem
# consegue voltar a entrar (os hashes guardados deixam de corresponder).
# Gera um com: openssl rand -hex 32
TOKEN_SECRET=

# Token do dono da conta (tu) - so tem efeito fora de producao (NODE_ENV
# != production), para ter uma chave previsivel em dev/testes. Em producao
# e sempre gerado automaticamente, tal como a de qualquer utilizador.
# Ve-lo outra vez com: npm run admin-token
ADMIN_TOKEN=

# Liga o atalho de login "mossy" (ver auth.js) - resolve sempre para o
# dono da conta, chave real que seja. So para dev/QA local; deixa vazio/
# false em qualquer coisa que se pareca com producao. Nao existe em
# fly.toml de proposito - o valor por omissao (ausente = desligado) tem de
# ser seguro mesmo que outra variavel falhe.
ENABLE_DEV_LOGIN=true

# Nome do dono da conta
ADMIN_NAME=Admin

# Chaves VAPID para Web Push. Gera com: npm run genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto para o servico de push (formato mailto:)
VAPID_SUBJECT=mailto:admin@example.com

# Permite promover/remover admins pelo painel. Deixa vazio em producao -
# so o dono da conta deve ter acesso de admin la.
ENABLE_ADMIN_PROMOTION=true

# Liga a feature Wall (publicacoes/sondagens). Desligada por omissao
# (producao); so o QA a liga enquanto a feature ainda esta a ser testada.
ENABLE_PLAZA=false

# Carrega dados de demonstracao (utilizadores, concorrentes, consequencias)
# em cada arranque - so para QA/pre-visualizacao local. Nunca em producao.
SEED_DEMO=false
