# Porta do servidor
PORT=3000

# Segredo usado para cifrar e indexar as chaves de acesso dos utilizadores.
# Mantem-no fora da base de dados e nunca o partilhes. Se o mudares, ninguem
# consegue voltar a entrar (os hashes guardados deixam de corresponder).
# Gera um com: openssl rand -hex 32
TOKEN_SECRET=

# Token do dono da conta (tu). Se vazio, e gerado automaticamente e impresso no arranque.
# Ve-lo outra vez com: npm run admin-token
ADMIN_TOKEN=

# Nome do dono da conta
ADMIN_NAME=Admin

# Chaves VAPID para Web Push. Gera com: npm run genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto para o servico de push (formato mailto:)
VAPID_SUBJECT=mailto:admin@example.com

# Permite promover/remover admins pelo painel. Deixa vazio em producao -
# so o dono da conta deve ter acesso de admin la.
ENABLE_ADMIN_PROMOTION=true

# Liga a feature Wall (publicacoes/sondagens). Desligada por omissao
# (producao); so o QA a liga enquanto a feature ainda esta a ser testada.
ENABLE_PLAZA=false

# Carrega dados de demonstracao (utilizadores, concorrentes, consequencias)
# em cada arranque - so para QA/pre-visualizacao local. Nunca em producao.
SEED_DEMO=false
