# Porta do servidor
PORT=3000

# Token do administrador (tu). Se vazio, e gerado automaticamente e impresso no arranque.
# Gera um seguro com: npm run admin-token
ADMIN_TOKEN=

# Nome do utilizador admin
ADMIN_NAME=Admin

# Fuso horario usado para "dia" e janela de votacao
TIMEZONE=Europe/Lisbon

# Chaves VAPID para Web Push. Gera com: npm run genkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto para o servico de push (formato mailto:)
VAPID_SUBJECT=mailto:admin@example.com
