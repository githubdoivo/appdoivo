{
  "name": "appdoivo",
  "version": "1.2.5",
  "description": "Party web app with four features: wall, rata, snatch and plaza.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.js",
    "genkeys": "node scripts/generate-vapid.js",
    "admin-token": "node --disable-warning=ExperimentalWarning scripts/print-admin-token.js",
    "seed-demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "test:ui": "node --disable-warning=ExperimentalWarning --test test/ui.test.js",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "engines": {
    "node": ">=23.4"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "yauzl": "^3.4.0"
  }
}
